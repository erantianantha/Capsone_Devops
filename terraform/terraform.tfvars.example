# Copy to terraform.tfvars (git-ignored) and adjust.
# Never put AWS access keys in this file; use `aws configure`/SSO or env vars.

project     = "pantrypal"
environment = "dev"
aws_region  = "us-east-1"

# Local mock AWS (moto). Remove or set to "" to deploy to a real AWS account.
mock_aws_endpoint = "http://localhost:5050"

vpc_cidr             = "10.20.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.20.0.0/20", "10.20.16.0/20"]
private_subnet_cidrs = ["10.20.128.0/20", "10.20.144.0/20"]
enable_nat_gateway   = true

cluster_version     = "1.34"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
